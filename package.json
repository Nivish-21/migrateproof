{
  "name": "migrateproof",
  "version": "0.1.0",
  "description": "Proves whether a consumer's real code and business invariant survive a recorded API behaviour change, via deterministic replay \u2014 no live API calls.",
  "keywords": [
    "api",
    "migration",
    "contract-testing",
    "regression-testing",
    "ci",
    "breaking-changes",
    "cli"
  ],
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "migrateproof": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "py/impact_analysis.py",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nivish-21/migrateproof.git"
  },
  "homepage": "https://github.com/Nivish-21/migrateproof#readme",
  "bugs": {
    "url": "https://github.com/Nivish-21/migrateproof/issues"
  },
  "author": "Nivish-21",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src test --no-error-on-unmatched-pattern",
    "format": "prettier --check src test --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts",
    "test:all": "npm test && npm run test:sandbox"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^12.0.0",
    "dockerode": "^4.0.2",
    "js-yaml": "^4.1.0",
    "msw": "^2.0.0",
    "ts-morph": "^21.0.1",
    "tsx": "^4.7.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.29",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
